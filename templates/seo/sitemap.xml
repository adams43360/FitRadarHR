{% autoescape on %}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for entry in urls %}  <url>
    <loc>{{ entry.loc }}</loc>
{% for code, href in entry.alternates.items %}    <xhtml:link rel="alternate" hreflang="{{ code }}" href="{{ href }}"/>
{% endfor %}    <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.x_default }}"/>
  </url>
{% endfor %}</urlset>
{% endautoescape %}
